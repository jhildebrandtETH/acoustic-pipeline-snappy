FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];   // incompressible kinematic pressure [m2/s2]

// Keep the same kinematic-pressure reference at inlet, outlet and initialization.
internalField   uniform 101325;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    inlet
    {
        type            totalPressure;
        p0              uniform 101325;
        value           uniform 101325;
    }

    outlet
    {
        type            fixedValue;
        value           uniform 101325;   // kinematic-pressure reference
    }

    walls
    {
        type            zeroGradient;
    }

    propeller
    {
        type            zeroGradient;
    }

    rotaryRegion
    {
    type    fixedFluxPressure;
    // If there are issues, revert back to:
    // type zeroGradient;
    }

    rotaryRegion_slave
    {
    type    fixedFluxPressure;
    // If there are issues, revert back to:
    // type zeroGradient;
    }

}

